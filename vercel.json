{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/carto-proxy/(.*)",
      "destination": "https://tiles.basemaps.cartocdn.com/$1"
    },
    {
      "source": "/carto-mvt-proxy/(.*)",
      "destination": "https://tiles-a.basemaps.cartocdn.com/$1"
    }
  ]
}
